{
  "name": "tl-dw",
  "version": "1.4.0",
  "description": "TL;DW (Too Long; Didn't Watch) summarizes any YouTube video right on the page with Gemini, or sends it to ChatGPT, Claude or NotebookLM.",
  "private": true,
  "license": "MIT",
  "author": "Nathan Watkins",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "TLDW_E2E=1 VITE_GEMINI_TIMEOUT_MS=250 VITE_PAGE_RUN_TIMEOUT_MS=15000 vite build --outDir dist-e2e && playwright test",
    "test:live-background-tab": "vite build --outDir dist-live && xvfb-run -a node scripts/live-background-tab.mjs dist-live",
    "build": "node scripts/build-release.mjs",
    "package": "node scripts/package-store.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "assets:store": "node scripts/capture-store-assets.mjs",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm run typecheck && npm test && vite build",
    "smoke:gemini": "node scripts/smoke-gemini.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@crxjs/vite-plugin": "3.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "release-kit": "github:n8watkins/release-kit#v2.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
